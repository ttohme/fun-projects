[Unit]
Description=AI Assistant — approved-job executor
Documentation=https://github.com/ttohme/fun-projects
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=600
StartLimitBurst=5
OnFailure=assistant-alert@%n.service

[Service]
Type=simple
User=__USER__
WorkingDirectory=__REPO__
EnvironmentFile=__REPO__/infra/env/.env
ExecStart=__REPO__/.venv/bin/python apps/orchestrator/job_executor.py --watch
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full

[Install]
WantedBy=multi-user.target
