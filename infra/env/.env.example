# ── LiteLLM ────────────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...
LITELLM_MASTER_KEY=changeme-litellm-master

# ── Langfuse ───────────────────────────────────────────────────────────────────
LANGFUSE_SECRET_KEY=sk-lf-...
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_HOST=http://langfuse:3000

# ── n8n ────────────────────────────────────────────────────────────────────────
N8N_ENCRYPTION_KEY=changeme-n8n-encryption
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=changeme-n8n-password
N8N_WEBHOOK_BASE_URL=http://localhost:5678

# ── Redis ──────────────────────────────────────────────────────────────────────
REDIS_PASSWORD=changeme-redis

# ── OpenHands ──────────────────────────────────────────────────────────────────
OPENHANDS_LLM_MODEL=anthropic/claude-sonnet-4-6
OPENHANDS_LLM_API_KEY=${ANTHROPIC_API_KEY}

# ── OpenClaw Gateway ───────────────────────────────────────────────────────────
OPENCLAW_TOKEN=changeme-openclaw-token

# ── Todoist ────────────────────────────────────────────────────────────────────
TODOIST_API_TOKEN=...

# ── Home Assistant ─────────────────────────────────────────────────────────────
HASS_TOKEN=...
HASS_URL=http://homeassistant.local:8123
