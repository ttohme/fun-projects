# ── LiteLLM ────────────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...
LITELLM_MASTER_KEY=changeme-litellm-master

# ── Langfuse ───────────────────────────────────────────────────────────────────
LANGFUSE_SECRET_KEY=sk-lf-...
LANGFUSE_PUBLIC_KEY=pk-lf-...
# Password-hashing salt required by Langfuse v2 (generate: openssl rand -hex 32)
LANGFUSE_SALT=changeme-langfuse-salt
# Postgres backing Langfuse (langfuse-db service in the compose files)
POSTGRES_PASSWORD=changeme-postgres
# Single machine: http://langfuse:3000
# 3-machine split: point LiteLLM (Pi 5) at Langfuse on the Pi 4 over the tailnet,
#   e.g. http://pi4.tailnet.ts.net:3000
LANGFUSE_HOST=http://langfuse:3000
# Login/callback URL Langfuse advertises (Pi 4). Single machine: http://localhost:3000
LANGFUSE_NEXTAUTH_URL=http://localhost:3000

# ── Ollama (local-private model) ─────────────────────────────────────────────────
# Single machine: http://host.docker.internal:11434
# 3-machine split: point at the Windows PC's Ollama over the tailnet,
#   e.g. http://windows-pc.tailnet.ts.net:11434
OLLAMA_BASE_URL=http://host.docker.internal:11434

# ── n8n ────────────────────────────────────────────────────────────────────────
# n8n 1.x uses built-in user management (owner account created in the UI on
# first launch) — the old N8N_BASIC_AUTH_* vars were removed in 1.0.
N8N_ENCRYPTION_KEY=changeme-n8n-encryption
N8N_WEBHOOK_BASE_URL=http://localhost:5678
# Full webhook URL the file-watcher POSTs to (path matches the file-intake workflow).
# 3-machine split: http://pi5.tailnet.ts.net:5678/webhook/file-intake
N8N_WEBHOOK_URL=http://localhost:5678/webhook/file-intake

# ── Backups (DB source of truth) ─────────────────────────────────────────────────
BACKUP_DIR=./backups
BACKUP_KEEP=14

# ── Redis ──────────────────────────────────────────────────────────────────────
REDIS_PASSWORD=changeme-redis

# ── ntfy push notifications ──────────────────────────────────────────────────────
# Self-hosted ntfy on the Pi 5. Empty NTFY_URL disables notifications entirely.
# The topic acts as a shared secret on the tailnet — use a long random string.
NTFY_URL=http://localhost:8090
NTFY_TOPIC=assistant-changeme-random

# ── Docker image tags (pin for reproducibility) ──────────────────────────────────
LITELLM_IMAGE_TAG=main-stable
OPENHANDS_IMAGE_TAG=0.38
OPENHANDS_RUNTIME_IMAGE=docker.all-hands.dev/all-hands-ai/runtime:0.38-nikolaik

# ── OpenHands (Windows PC) ───────────────────────────────────────────────────────
# OpenHands talks to the LiteLLM proxy, so the model must be a
# litellm_proxy/<alias> from infra/litellm.yaml and the API key it uses is
# LITELLM_MASTER_KEY (wired directly in the compose files).
OPENHANDS_LLM_MODEL=litellm_proxy/planner
# Single machine: http://litellm:4000
# 3-machine split: point at the Pi 5's LiteLLM over the tailnet,
#   e.g. http://pi5.tailnet.ts.net:4000
OPENHANDS_LLM_BASE_URL=http://litellm:4000

# ── OpenClaw Gateway ───────────────────────────────────────────────────────────
OPENCLAW_TOKEN=changeme-openclaw-token

# ── Telegram capture bot (optional) ──────────────────────────────────────────────
# Create with @BotFather. Configure the token as an n8n Telegram credential —
# this entry is the reference copy. Restrict to your own chat id.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_CHAT_ID=

# ── Todoist ────────────────────────────────────────────────────────────────────
TODOIST_API_TOKEN=...

# ── Home Assistant ─────────────────────────────────────────────────────────────
HASS_TOKEN=...
HASS_URL=http://homeassistant.local:8123

# ── Pipedream (optional MCP server, disabled in mcp/registry.yaml) ───────────────
# PIPEDREAM_API_TOKEN=...

# ── Healthcheck overrides (scripts/healthcheck.sh) ───────────────────────────────
# Defaults probe localhost; in the 3-machine split, point Langfuse at the Pi 4:
# N8N_URL=http://localhost:5678/healthz
# LITELLM_URL=http://localhost:4000/health/liveliness
# OPENCLAW_URL=http://localhost:18789/health
# LANGFUSE_URL=http://pi4.tailnet.ts.net:3000/api/public/health
