# ── LiteLLM ────────────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...
LITELLM_MASTER_KEY=changeme-litellm-master

# ── Langfuse ───────────────────────────────────────────────────────────────────
LANGFUSE_SECRET_KEY=sk-lf-...
LANGFUSE_PUBLIC_KEY=pk-lf-...
# Single machine: http://langfuse:3000
# 3-machine split: point LiteLLM (Pi 5) at Langfuse on the Pi 4 over the tailnet,
#   e.g. http://pi4.tailnet.ts.net:3000
LANGFUSE_HOST=http://langfuse:3000
# Login/callback URL Langfuse advertises (Pi 4). Single machine: http://localhost:3000
LANGFUSE_NEXTAUTH_URL=http://localhost:3000

# ── Ollama (local-private model) ─────────────────────────────────────────────────
# Single machine: http://host.docker.internal:11434
# 3-machine split: point at the Windows PC's Ollama over the tailnet,
#   e.g. http://windows-pc.tailnet.ts.net:11434
OLLAMA_BASE_URL=http://host.docker.internal:11434

# ── n8n ────────────────────────────────────────────────────────────────────────
N8N_ENCRYPTION_KEY=changeme-n8n-encryption
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=changeme-n8n-password
N8N_WEBHOOK_BASE_URL=http://localhost:5678
# Full webhook URL the file-watcher POSTs to (path matches the file-intake workflow).
# 3-machine split: http://pi5.tailnet.ts.net:5678/webhook/file-intake
N8N_WEBHOOK_URL=http://localhost:5678/webhook/file-intake

# ── Backups (DB source of truth) ─────────────────────────────────────────────────
BACKUP_DIR=./backups
BACKUP_KEEP=14

# ── Redis ──────────────────────────────────────────────────────────────────────
REDIS_PASSWORD=changeme-redis

# ── Docker image tags (pin for reproducibility) ──────────────────────────────────
LITELLM_IMAGE_TAG=main-stable
OPENHANDS_IMAGE_TAG=0.38

# ── OpenHands (Windows PC) ───────────────────────────────────────────────────────
OPENHANDS_LLM_MODEL=anthropic/claude-sonnet-4-6
OPENHANDS_LLM_API_KEY=${ANTHROPIC_API_KEY}
# Single machine: http://litellm:4000
# 3-machine split: point at the Pi 5's LiteLLM over the tailnet,
#   e.g. http://pi5.tailnet.ts.net:4000
OPENHANDS_LLM_BASE_URL=http://litellm:4000

# ── OpenClaw Gateway ───────────────────────────────────────────────────────────
OPENCLAW_TOKEN=changeme-openclaw-token

# ── Todoist ────────────────────────────────────────────────────────────────────
TODOIST_API_TOKEN=...

# ── Home Assistant ─────────────────────────────────────────────────────────────
HASS_TOKEN=...
HASS_URL=http://homeassistant.local:8123
