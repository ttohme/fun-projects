{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "task-object.schema.json",
  "title": "Task Object",
  "description": "Normalized task representation used across triage, capture, and workflow nodes.",
  "type": "object",
  "required": ["title", "intent", "source_type", "approval_required", "confidence"],
  "additionalProperties": false,
  "properties": {
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500,
      "description": "Short imperative task title suitable for Todoist."
    },
    "intent": {
      "type": "string",
      "enum": [
        "create_task",
        "update_task",
        "delete_task",
        "send_email",
        "home_control_read",
        "home_control_write",
        "code_job",
        "document_triage",
        "unknown"
      ]
    },
    "source_type": {
      "type": "string",
      "enum": ["email", "voice", "file", "webhook", "chat"]
    },
    "source_ref": {
      "type": "string",
      "description": "External reference ID from the source system."
    },
    "description": {
      "type": "string",
      "description": "Full task body / notes."
    },
    "project": {
      "type": "string",
      "default": "Inbox",
      "description": "Todoist project name."
    },
    "labels": {
      "type": "array",
      "items": {"type": "string"},
      "default": []
    },
    "due_string": {
      "type": ["string", "null"],
      "description": "Natural language due date, passed directly to Todoist API."
    },
    "priority": {
      "type": "integer",
      "minimum": 1,
      "maximum": 4,
      "default": 4,
      "description": "Todoist priority: 1=urgent, 4=normal."
    },
    "approval_required": {
      "type": "boolean",
      "description": "True if a human must approve before this task is acted on."
    },
    "confidence": {
      "type": "number",
      "minimum": 0.0,
      "maximum": 1.0,
      "description": "Classification confidence from triage agent."
    },
    "dedupe_key": {
      "type": "string",
      "description": "SHA256 of source_ref + '|' + title for deduplication."
    },
    "hass_entity_id": {
      "type": "string",
      "description": "Home Assistant entity to read (home_control_read), e.g. 'light.kitchen'."
    },
    "hass_domain": {
      "type": "string",
      "description": "Home Assistant service domain (home_control_write), e.g. 'light'."
    },
    "hass_service": {
      "type": "string",
      "description": "Home Assistant service name (home_control_write), e.g. 'turn_on'."
    },
    "hass_service_data": {
      "type": "object",
      "description": "Service call payload (home_control_write), e.g. {\"entity_id\": \"light.kitchen\"}."
    }
  }
}
